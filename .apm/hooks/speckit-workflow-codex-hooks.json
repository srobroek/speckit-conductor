{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-pr-title.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-tasks-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-dispatcher.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/speckit-dispatcher.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
